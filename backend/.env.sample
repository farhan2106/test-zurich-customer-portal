# =============================================================================
# Zurich App — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# --- PostgreSQL Database ---
# Hostname or IP of the PostgreSQL server
DB_HOST=<your-database-host>
# Port the PostgreSQL server listens on (default: 5432)
DB_PORT=<your-database-port>
# Database user with read/write access to the application schema
DB_USERNAME=<your-database-username>
# Password for the database user
DB_PASSWORD=<your-database-password>
# Name of the application database
DB_DATABASE=<your-database-name>

# --- Google OAuth 2.0 ---
# Client ID from the Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
# Client secret paired with the Client ID above
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# --- Authentication ---
# Secret key used to sign and verify JWT tokens (generate with: openssl rand -hex 64)
JWT_SECRET=<your-jwt-secret>

# --- Networking ---
# Full base URL of the backend API server (e.g. http://localhost:3001)
API_URL=<your-api-url>
