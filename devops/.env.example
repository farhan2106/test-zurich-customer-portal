# =============================================================================
# Zurich App — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before deploying.
# Command: cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection details for the PostgreSQL database.
# Inside Docker Compose, DB_HOST should be the service name "postgres".
# For external databases, use the hostname or IP address.

DB_HOST=postgres              # PostgreSQL host (default: postgres)
DB_PORT=5432                  # PostgreSQL port (default: 5432)
DB_USERNAME=postgres          # Database user (default: postgres)
DB_PASSWORD=zurich_secret     # Database password — CHANGE THIS IN PRODUCTION
DB_DATABASE=zurich_app        # Database name (default: zurich_app)

# -----------------------------------------------------------------------------
# Authentication (REQUIRED — no safe defaults)
# -----------------------------------------------------------------------------
# These values MUST be set before the application will start.

# JWT signing secret — used to sign and verify authentication tokens.
# Generate a secure random value with:
#   openssl rand -hex 64
JWT_SECRET=                   # REQUIRED — JWT signing secret

# Google OAuth credentials — used for Google Sign-In.
# Create these at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=             # REQUIRED — Google OAuth client ID
GOOGLE_CLIENT_SECRET=         # REQUIRED — Google OAuth client secret

# -----------------------------------------------------------------------------
# Networking — Public URLs
# -----------------------------------------------------------------------------
# These URLs are used for CORS, redirects, and client-side configuration.

API_URL=http://localhost:3001           # Backend API base URL
FRONTEND_URL=http://localhost:3000      # Frontend application URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api  # API URL exposed to browser code

# -----------------------------------------------------------------------------
# Ports — Host Port Mapping
# -----------------------------------------------------------------------------
# Ports on the host machine that map to the Docker container ports.
# Change these if the default ports are already in use on your host.

BACKEND_PORT=3001           # Host port for the backend API (container: 3001)
FRONTEND_PORT=3000          # Host port for the frontend app (container: 3000)
